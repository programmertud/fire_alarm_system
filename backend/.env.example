# ============================================================
#  Fire Alarm IoT — Backend Environment Variables
# ============================================================

PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ── TextBee SMS Gateway (Free Android SMS) ─────────────────────
# 1. Sign up free at https://textbee.dev
# 2. Install TextBee on your Android phone and link it
# 3. Copy your API Key from the dashboard
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=

# ── Brevo (Sendinblue) Transactional Email (Free 300 emails/day)
# 1. Sign up free at https://brevo.com
# 2. Go to Settings / SMTP & API / API Keys -> Create new API key (v3)
# 3. Add your verified sender email address in Brevo (Senders & IP)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_verified_email@gmail.com
BREVO_SENDER_NAME=Fire Alarm IoT Alert System

# ── Alert Cooldown ─────────────────────────────────────────────
# Minutes between recurring alerts per phone/email while alarm is active
ALERT_COOLDOWN_MINUTES=5
